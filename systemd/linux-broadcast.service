[Unit]
Description=Linux Broadcast NVIDIA AFX voice service
After=pipewire.service wireplumber.service
PartOf=graphical-session.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
ExecStart=%h/.local/bin/linux-broadcast --background
Environment=WEBKIT_DISABLE_DMABUF_RENDERER=1
Restart=on-failure
RestartSec=5
TimeoutStopSec=8
# Keep native desktop helpers sandboxed without the glycin/bwrap regression (#1).
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
LockPersonality=true
# The reporter isolated this option as the cause of the Arch/glycin crash.
RestrictSUIDSGID=false
# ProtectSystem=strict also covers HOME. Keep only application state, caches,
# user login controls, and the desktop runtime directory writable.
Environment=XDG_CACHE_HOME=%h/.cache/linux-broadcast
Environment=CUDA_CACHE_PATH=%h/.cache/linux-broadcast/cuda
ReadWritePaths=%h/.config/linux-broadcast %h/.config/systemd/user
ReadWritePaths=%h/.local/share/com.arzvak.linuxbroadcast %h/.cache/linux-broadcast %t
UMask=0077

[Install]
WantedBy=graphical-session.target
