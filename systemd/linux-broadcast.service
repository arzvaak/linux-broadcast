[Unit]
Description=Linux Broadcast NVIDIA AFX voice service
After=pipewire.service wireplumber.service
PartOf=graphical-session.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
ExecStart=%h/.local/bin/linux-broadcast --background
Environment=WEBKIT_DISABLE_DMABUF_RENDERER=1
Restart=on-failure
RestartSec=5
TimeoutStopSec=8
# This is a desktop session application. GTK/glycin and WebKit launch their
# own sandboxed helpers. Outer namespace/seccomp/privilege restrictions can
# prevent those helpers from starting (including bubblewrap image loaders).
UMask=0077

[Install]
WantedBy=graphical-session.target
